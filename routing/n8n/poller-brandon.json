{
  "name": "A2A routing: brandon",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Chicago",
    "saveDataSuccessExecution": "none"
  },
  "nodes": [
    {
      "id": "brandon-schedule",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "brandon-poll",
      "name": "Poll owner_brandon",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "command": "cd \"$A2A_ROUTING_DIR\" && flock -n /tmp/a2a-routing-brandon.lock python3 -m routing.cli poll --bot brandon"
      }
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Poll owner_brandon",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
