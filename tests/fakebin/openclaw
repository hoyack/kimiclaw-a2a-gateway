#!/usr/bin/env python3
"""Fake openclaw CLI: reads the message from stdin (--message-file -), records argv, message and env names to
$HOME/argv.jsonl, emits a result envelope like the real one."""
import json, os, sys, time
assert sys.argv[sys.argv.index("--message-file") + 1] == "-"
msg = sys.stdin.read()
with open(os.path.join(os.environ["HOME"], "argv.jsonl"), "a") as f:
    f.write(json.dumps({"argv": sys.argv[1:], "message": msg, "env": sorted(os.environ)}) + "\n")
if "FAIL" in msg:
    sys.stderr.write("boom\n"); sys.exit(3)
if "SLOW" in msg:
    time.sleep(2)
sys.stderr.write("[log] noise line\n{not json\n")
sys.stderr.write(json.dumps({"payloads": [{"text": "echo: " + msg}], "meta": {}}) + "\n")
