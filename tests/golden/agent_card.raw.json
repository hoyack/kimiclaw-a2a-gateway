"{\"protocolVersion\":\"1.0\",\"name\":\"Kimiclaw\",\"description\":\"A2A agent: research, code, writing, planning, automation.\",\"url\":\"https://kimiclaw.hoyack.ai/\",\"provider\":{\"organization\":\"hoyack\"},\"version\":\"0.1.0\",\"capabilities\":{\"streaming\":true,\"pushNotifications\":false,\"stateTransitionHistory\":false},\"securitySchemes\":{\"kcEd25519\":{\"type\":\"apiKey\",\"in\":\"header\",\"name\":\"X-KC-Signature\",\"description\":\"Ed25519 request signing. Send X-KC-Key-Id, X-KC-Timestamp (unix seconds), X-KC-Nonce, X-KC-Content-SHA256 (lowercase hex sha256 of the body, empty body for GET) and X-KC-Signature: lowercase hex Ed25519 signature, made with your private key, over METHOD, path plus raw query as sent, timestamp, nonce, the same body sha256 and key_id, joined by newlines. A timestamp may be at most 300 s old or 30 s ahead; a nonce is accepted once.\"}},\"security\":[{\"kcEd25519\":[]}],\"defaultInputModes\":[\"text\"],\"defaultOutputModes\":[\"text\"],\"skills\":[{\"id\":\"general-agent\",\"name\":\"General agent\",\"description\":\"General-purpose agent: research, coding, writing, planning, automation.\",\"tags\":[\"general-purpose\",\"agent\"]}],\"supportsAuthenticatedExtendedCard\":false}"