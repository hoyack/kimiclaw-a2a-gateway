# Placeholders only. Copy to .env (gitignored) and fill in real values outside version control.
# Only needed with GATEWAY_NOTIFY_URL; never accepted inbound.
KIMICLAW_TOKEN=<notify-credential>
# Per-caller signing secrets (see README "Caller keys"); a mounted file path (mode 0400/0440), never secret values.
GATEWAY_SIGNING_KEYS_FILE=</path/to/keys.txt>
GATEWAY_CREATE_PER_MIN=10
GATEWAY_CREATE_BURST=5
GATEWAY_GET_PER_S=2
GATEWAY_CANCEL_PER_S=1
GATEWAY_MAX_INFLIGHT_PER_KEY=2
GATEWAY_MAX_PENDING=50
GATEWAY_MAX_TASKS_PER_KEY=100
GATEWAY_MAX_NONCES_PER_CALLER=20000
GATEWAY_REQUESTS_PER_S=5
GATEWAY_REQUESTS_BURST=10
GATEWAY_TELEMETRY_FILE_MB=10
GATEWAY_PUBLIC_URL=https://kimiclaw.hoyack.ai/
GATEWAY_NOTIFY_URL=<n8n-a2a-firewall-webhook-url>
# Must be `basic` for the n8n A2A_Firewall webhook (sends Authorization: Basic base64(user:KIMICLAW_TOKEN)).
GATEWAY_NOTIFY_AUTH_MODE=basic
GATEWAY_NOTIFY_AUTH_USER=<n8n-basic-auth-user>
GATEWAY_NOTIFY_EVENTS=task_completed,task_failed
GATEWAY_NOTIFY_FAIL_LIMIT=5
GATEWAY_NOTIFY_COOLDOWN_S=900
GATEWAY_TELEMETRY_DIR=telemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<otlp-host>:4318   # set = OTLP instead of files; unset = files (daily, 7 days kept)
